{
	"name": "n8n-nodes-ovhcloud",
	"version": "1.1.0",
	"description": "n8n nodes for OVH Cloud services",
	"license": "MIT",
	"homepage": "https://github.com/ziouf/n8n-nodes-ovhcloud",
	"keywords": [
		"n8n-community-node-package",
		"n8n",
		"n8n-node",
		"n8n-nodes",
		"n8n-community",
		"ovh",
		"ovhcloud",
		"ovh-cloud",
		"ovh-api",
		"cloud",
		"cloud-services",
		"api",
		"rest-api",
		"automation",
		"workflow-automation",
		"integration",
		"typescript",
		"nodejs"
	],
	"author": {
		"name": "Cyril MARIN",
		"email": "marin.cyril@gmail.com"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/ziouf/n8n-nodes-ovhcloud.git"
	},
	"scripts": {
		"build": "n8n-node build && node scripts/generate-nodes-manifest.js",
		"build:watch": "tsc --watch",
		"dev": "n8n-node dev",
		"lint": "n8n-node lint",
		"lint:fix": "n8n-node lint --fix",
		"release": "n8n-node release",
		"prepublishOnly": "n8n-node prerelease",
		"test": "jest",
		"test:coverage": "jest --coverage",
		"generate:nodes-manifest": "node scripts/generate-nodes-manifest.js"
	},
	"files": [
		"dist"
	],
	"n8n": {
		"n8nNodesApiVersion": 1,
		"strict": false,
		"credentials": [
			"dist/credentials/OvhCloudApi.credentials.js"
		],
		"nodes": [
			"dist/nodes/OvhCloudBackupServices/OvhCloudBackupServices.node.js",
			"dist/nodes/OvhCloudCdn/OvhCloudCdn.node.js",
			"dist/nodes/OvhCloudCluster/OvhCloudCluster.node.js",
			"dist/nodes/OvhCloudCommercialCatalog/OvhCloudCommercialCatalog.node.js",
			"dist/nodes/OvhCloudDbaas/OvhCloudDbaas.node.js",
			"dist/nodes/OvhCloudDedicated/OvhCloudDedicated.node.js",
			"dist/nodes/OvhCloudDedicatedCloud/OvhCloudDedicatedCloud.node.js",
			"dist/nodes/OvhCloudDomain/OvhCloudDomain.node.js",
			"dist/nodes/OvhCloudDomainV2/OvhCloudDomainV2.node.js",
			"dist/nodes/OvhCloudEmailPro/OvhCloudEmailPro.node.js",
			"dist/nodes/OvhCloudHosting/OvhCloudHosting.node.js",
			"dist/nodes/OvhCloudHostingWebResource/OvhCloudHostingWebResource.node.js",
			"dist/nodes/OvhCloudIPLoadbalancing/OvhCloudIPLoadbalancing.node.js",
			"dist/nodes/OvhCloudIam/OvhCloudIam.node.js",
			"dist/nodes/OvhCloudIp/OvhCloudIp.node.js",
			"dist/nodes/OvhCloudLocation/OvhCloudLocation.node.js",
			"dist/nodes/OvhCloudManagedCMS/OvhCloudManagedCMS.node.js",
			"dist/nodes/OvhCloudMe/OvhCloudMe.node.js",
			"dist/nodes/OvhCloudMsServices/OvhCloudMsServices.node.js",
			"dist/nodes/OvhCloudMxPlan/OvhCloudMxPlan.node.js",
			"dist/nodes/OvhCloudNetworkDefense/OvhCloudNetworkDefense.node.js",
			"dist/nodes/OvhCloudNotification/OvhCloudNotification.node.js",
			"dist/nodes/OvhCloudOkms/OvhCloudOkms.node.js",
			"dist/nodes/OvhCloudOrder/OvhCloudOrder.node.js",
			"dist/nodes/OvhCloudPack/OvhCloudPack.node.js",
			"dist/nodes/OvhCloudPrice/OvhCloudPrice.node.js",
			"dist/nodes/OvhCloudPublicCloud/OvhCloudPublicCloud.node.js",
			"dist/nodes/OvhCloudPublicCloudAi/OvhCloudPublicCloudAi.node.js",
			"dist/nodes/OvhCloudPublicCloudV2/OvhCloudPublicCloudV2.node.js",
			"dist/nodes/OvhCloudService/OvhCloudService.node.js",
			"dist/nodes/OvhCloudServices/OvhCloudServices.node.js",
			"dist/nodes/OvhCloudSms/OvhCloudSms.node.js",
			"dist/nodes/OvhCloudSsl/OvhCloudSsl.node.js",
			"dist/nodes/OvhCloudStorage/OvhCloudStorage.node.js",
			"dist/nodes/OvhCloudSupport/OvhCloudSupport.node.js",
			"dist/nodes/OvhCloudTelephony/OvhCloudTelephony.node.js",
			"dist/nodes/OvhCloudVeeamEnterprisePlus/OvhCloudVeeamEnterprisePlus.node.js",
			"dist/nodes/OvhCloudVmwareCloudDirector/OvhCloudVmwareCloudDirector.node.js",
			"dist/nodes/OvhCloudVps/OvhCloudVps.node.js",
			"dist/nodes/OvhCloudVrack/OvhCloudVrack.node.js",
			"dist/nodes/OvhCloudVrackServices/OvhCloudVrackServices.node.js",
			"dist/nodes/OvhCloudWebhostingV2/OvhCloudWebhostingV2.node.js",
			"dist/nodes/OvhCloudZimbra/OvhCloudZimbra.node.js"
		]
	},
	"devDependencies": {
		"@n8n/node-cli": "*",
		"@types/jest": "^30.0.0",
		"eslint": "9.32.0",
		"jest": "^30.3.0",
		"prettier": "3.6.2",
		"release-it": "^19.0.4",
		"ts-jest": "^29.4.9",
		"tsx": "^4.23.1",
		"typescript": "5.9.2"
	},
	"peerDependencies": {
		"n8n-workflow": "*"
	}
}
